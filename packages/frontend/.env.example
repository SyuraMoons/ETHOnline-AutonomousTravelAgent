NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# --- Hedera / x402 ---

# RPC endpoint used for on-chain reads. Defaults to the public testnet RPC if unset.
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Self-hosted x402 Hedera facilitator (see docker-compose.yml / facilitator/).
FACILITATOR_URL=http://localhost:4020
X402_NETWORK=hedera:testnet
# Must match X402_NETWORK; used by the browser x402 client (HashPack).
NEXT_PUBLIC_X402_NETWORK=hedera:testnet

# --- Persistence (Supabase/Postgres) ---

# Durable store for mandates, spend, consent sessions, dossiers and chat threads (see
# supabase/schema.sql and services/db/supabase.ts). Server-side only — never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AutoVoyage planner (see AGENTS.md "Target Build") ---

# packages/supplier — the real x402-gated flight data service the planner pays.
SUPPLIER_BASE_URL=http://localhost:4100

# The planner's own server-held Hedera key ("the agent's wallet"). Must be a
# funded ECDSA testnet account DISTINCT from both the facilitator fee-payer
# (root .env FACILITATOR_ACCOUNT_ID) and the supplier's PAY_TO
# (packages/supplier/.env) — same-account payments are rejected by the
# facilitator (see RUNBOOK.md).
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=

# Default spending mandate applied when a /api/plan request carries no
# mandateId (see services/autovoyage/mandate.ts). checkMandate() enforces
# these; a bug here is the one place that loses money live.
AGENT_MANDATE_TOTAL_HBAR=5
AGENT_MANDATE_PER_TX_HBAR=2.5
AGENT_MANDATE_TTL_MINUTES=60

# HCS topics: service registry (read at boot) and audit trail (payments,
# approvals, bookings, refusals).
HCS_REGISTRY_TOPIC_ID=
HCS_AUDIT_TOPIC_ID=

# Signs/verifies the short-lived token minted at consent-verify and spent at execute.
EXECUTION_TOKEN_SECRET=
EXECUTION_TOKEN_TTL_SECONDS=300

# Bounded LLM call to parse a free-text brief into structured legs. The LLM
# never touches money or sees a price. OpenRouter (OpenAI-compatible).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.6-luna

# "live" hits the real supplier/facilitator; "offline" replays a fixture plan.
NEXT_PUBLIC_DEMO_MODE=live
# POST /api/plan transport: server-sent events vs. client polling.
NEXT_PUBLIC_TRANSPORT=sse
