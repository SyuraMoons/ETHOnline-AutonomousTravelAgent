{
  "name": "@sh/supplier",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit --incremental && tsc -p tsconfig.scripts.json",
    "flights:generate": "tsx scripts/scrape-flights.ts",
    "test": "node --import tsx --test src/**/*.test.ts src/**/**/*.test.ts",
    "stays:generate": "tsx scripts/generate-stays.ts",
    "activities:generate": "tsx scripts/generate-activities.ts",
    "data:generate": "npm run flights:generate && npm run stays:generate && npm run activities:generate",
    "gen-signing-key": "tsx scripts/gen-signing-key.ts",
    "data:inspect": "tsx scripts/inspect-data.ts",
    "preflight": "tsx scripts/preflight.ts",
    "setup-env": "tsx scripts/setup-env.ts"
  },
  "dependencies": {
    "@sh/contracts": "*",
    "@x402/core": "^2.14.0",
    "@x402/hedera": "^2.13.2",
    "dotenv": "^16.6.1",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.11",
    "tsx": "^4.19.1",
    "typescript": "^5.8.2"
  },
  "packageManager": "npm@10.0.0"
}
