# Same self-hosted facilitator as packages/frontend (see docker-compose.yml / facilitator/).
# Swapping to a different facilitator (e.g. a hosted one) is a one-line change here.
#
# Alternative: Blocky402's hosted testnet facilitator (https://api.testnet.blocky402.com,
# no API key needed) — wire-compatible, but its advertised fee-payer is fixed to its own
# account, so it only works for treasury-mode payments (e.g. scripts/x402-buy.ts), never
# the allowance-mode flow /api/plan uses. See AGENTS.md "Blocky402 as an alternate facilitator".
FACILITATOR_URL=http://localhost:4020
X402_NETWORK=hedera:testnet

PORT=4100
# Public URL this service is reachable at — used in the /.well-known/x402
# agent card's service endpoints. Defaults to http://localhost:$PORT.
PUBLIC_BASE_URL=http://localhost:4100

# Hedera account id that receives buyer payments (the x402 `payTo`). This is
# a plain account id, not a key — the supplier never holds a private key that
# can move funds; only the buyer's wallet/agent key and the facilitator's
# fee-payer key sign transactions.
PAY_TO=0.0.xxxxxx

# Metered search pricing, one band per domain:
#   clamp(resultCount * PER_RESULT, MIN, MAX)
#
# The rates differ because the rows are not worth the same. A flight row is a
# whole itinerary leg; an activity row is one start time for one experience,
# and a single day in one city yields dozens. The cap is what keeps an
# unfiltered "show me everything" search from costing more than the trip.
SEARCH_PRICE_PER_RESULT_HBAR=0.05
SEARCH_PRICE_MIN_HBAR=0.10
SEARCH_PRICE_MAX_HBAR=2.50

# GET /v1/stays/search
STAY_PRICE_PER_RESULT_HBAR=0.04
STAY_PRICE_MIN_HBAR=0.10
STAY_PRICE_MAX_HBAR=2.00

# GET /v1/activities/search
ACTIVITY_PRICE_PER_RESULT_HBAR=0.02
ACTIVITY_PRICE_MIN_HBAR=0.05
ACTIVITY_PRICE_MAX_HBAR=1.00

# POST /v1/booking carries no HBAR charge: the fare goes to the buyer's card,
# which is a different amount owed to a different party.

# Quote-token cache lifetime: shorter before payment, longer once paid.
QUOTE_TTL_UNPAID_SECONDS=300
QUOTE_TTL_PAID_SECONDS=900

# Ed25519 private key the supplier uses to sign CONFIRMED_SIMULATED booking
# confirmations. Generate a dedicated keypair for this — never reuse a
# funded Hedera account key here. Base64-encoded PKCS8 DER.
# Generate with: npm run supplier:gen-signing-key
SUPPLIER_SIGNING_KEY=

# Facilitator verify/settle timeout. The library default of 30s is not enough
# for settle on testnet — a completed payment then reads as a failure, and a
# retry charges the buyer twice.
FACILITATOR_TIMEOUT_MS=120000
