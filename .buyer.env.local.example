# Credentials for the agent that SPENDS, used by `npm run x402:buy`.
#
# Must be the account the facilitator advertises as feePayer — check with:
#   curl -s localhost:4020/health
# In allowance mode the agent owns the transaction, so a different account here
# will be rejected even though everything else is configured correctly.
#
# Copy to .buyer.env.local (gitignored) and fill in. Load it with:
#   set -a && . ./.buyer.env.local && set +a

BUYER_ACCOUNT_ID=0.0.10495316
# HEX Encoded Private Key from portal.hedera.com for the account above.
BUYER_PRIVATE_KEY=
